rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Use the Firestore user record for coach and admin access checks.
    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data;
    }
    function isCoachOf(studentUid) {
      return request.auth != null && (
        userDoc(studentUid).coachUid == request.auth.uid ||
        (userDoc(studentUid).coaches != null && request.auth.uid in userDoc(studentUid).coaches)
      );
    }
    function isAdmin() {
      return request.auth != null && userDoc(request.auth.uid).isAdmin == true;
    }
    // Require an approved account before accepting uploads; missing profiles fail closed.
    function isApprovedMember(uid) {
      let u = userDoc(uid);
      return u.get('isApproved', false) == true || u.get('isAdmin', false) == true;
    }

    // Keep voice diaries private to their owner and bound uploaded file types and sizes.
    match /audio_diaries/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && isApprovedMember(userId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Limit swing video access to the owner, their coach, and admins; constrain uploads.
    match /videos/{userId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isCoachOf(userId) || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && isApprovedMember(userId)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
