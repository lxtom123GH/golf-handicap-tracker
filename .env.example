# Copy to .env for local dev (gitignored). Vite inlines VITE_* at build time.
# For the PRODUCTION deploy, these must also be set as GitHub Actions repo
# variables/secrets wired into deploy-production.yml (a local .env only affects
# your local build).

# --- App Check (BL-DD-01) -----------------------------------------------------
# reCAPTCHA v3 *site* key (public — safe to ship in the client bundle). REQUIRED
# in production: the AI callables enforce App Check, so a client built without
# this key is rejected (403). Get it from Firebase console -> App Check ->
# register the app with a reCAPTCHA v3 provider.
VITE_RECAPTCHA_SITE_KEY=

# --- Firebase web config (public) --------------------------------------------
# Mirrors the project's public web config. (firebase-config.js also carries
# these; keep them in sync if you rely on the env path.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
